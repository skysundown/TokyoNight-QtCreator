<?xml version="1.0" encoding="UTF-8"?>
<!--
    Tokyo Night for Qt Creator

    Converted from the VS Code theme "Tokyo Night" by Enkia
    https://marketplace.visualstudio.com/items?itemName=enkia.tokyo-night

    Install: copy this file into
      Windows : %APPDATA%/QtProject/qtcreator/styles/
      Linux   : ~/.config/QtProject/qtcreator/styles/
      macOS   : ~/Library/Application Support/QtProject/qtcreator/styles/
    then restart Qt Creator and pick it under
      Tools > Options > Text Editor > Fonts && Colors > Color Scheme
-->
<style-scheme version="1.0" name="Tokyo Night">
  <style name="Text" foreground="#a9b1d6" background="#1a1b26"/>
  <style name="Selection" foreground="#a9b1d6" background="#2a2e40"/>
  <style name="CurrentLine" background="#1e202e"/>
  <style name="LineNumber" foreground="#363b54" background="#1a1b26"/>
  <style name="CurrentLineNumber" foreground="#787c99" background="#1a1b26" bold="true"/>
  <style name="VisualWhitespace" foreground="#363b54"/>
  <style name="Parentheses" foreground="#42465d" background="#16161e"/>
  <style name="ParenthesesMismatch" background="#ff5370" bold="true"/>
  <style name="AutoComplete" foreground="#1a1b26" background="#0db9d7"/>
  <style name="Link" foreground="#73daca"/>
  <style name="SearchResult" background="#283357"/>
  <style name="SearchResultAlt1" foreground="#bb9af7" background="#2a2e40"/>
  <style name="SearchResultAlt2" foreground="#ff9e64" background="#2a2e40"/>
  <style name="SearchResultContainingFunction" foreground="#a9b1d6" background="#1a1b26"/>
  <style name="SearchScope" background="#e0af68"/>
  <style name="Occurrences" background="#2a2e40"/>
  <style name="Occurrences.Unused" foreground="#363b54"/>
  <style name="Occurrences.Rename" foreground="#ff5370" background="#914c54"/>
  <style name="Comment" foreground="#51597d" italic="true"/>
  <style name="Doxygen.Comment" foreground="#5a638c" bold="true" italic="true"/>
  <style name="Doxygen.Tag" foreground="#646e9c"/>
  <style name="Number" foreground="#ff9e64"/>
  <style name="String" foreground="#9ece6a"/>
  <style name="Type" foreground="#0db9d7"/>
  <style name="PrimitiveType" foreground="#0db9d7"/>
  <style name="Keyword" foreground="#bb9af7"/>
  <style name="Attribute" foreground="#73daca"/>
  <style name="Operator" foreground="#89ddff"/>
  <style name="Overloaded Operator" foreground="#89ddff"/>
  <style name="Punctuation" foreground="#89ddff"/>
  <style name="Preprocessor" foreground="#73daca"/>
  <style name="Macro" foreground="#73daca"/>
  <style name="Label" foreground="#bb9af7"/>
  <style name="Function" foreground="#7aa2f7"/>
  <style name="VirtualMethod" foreground="#7aa2f7" italic="true"/>
  <style name="Global" foreground="#c0caf5"/>
  <style name="Local" foreground="#c0caf5"/>
  <style name="Parameter" foreground="#e0af68"/>
  <style name="Field" foreground="#73daca"/>
  <style name="Static" foreground="#0db9d7" italic="true"/>
  <style name="Declaration" bold="true"/>
  <style name="OutputArgument" italic="true"/>
  <style name="QmlLocalId" foreground="#73daca" italic="true"/>
  <style name="QmlExternalId" foreground="#0db9d7" italic="true"/>
  <style name="QmlTypeId" foreground="#0db9d7"/>
  <style name="QmlRootObjectProperty" foreground="#73daca" italic="true"/>
  <style name="QmlScopeObjectProperty" foreground="#c0caf5" italic="true"/>
  <style name="QmlExternalObjectProperty" foreground="#0db9d7" italic="true"/>
  <style name="QmlStateName" foreground="#bb9af7"/>
  <style name="Binding" foreground="#73daca"/>
  <style name="JsScopeVar" foreground="#c0caf5" italic="true"/>
  <style name="JsImportVar" foreground="#0db9d7" italic="true"/>
  <style name="JsGlobalVar" foreground="#c0caf5" italic="true"/>
  <style name="DisabledCode" foreground="#363b54" background="#1e202e"/>
  <style name="InlayText" foreground="#51597d" italic="true"/>
  <style name="AddedLine" foreground="#449dab"/>
  <style name="RemovedLine" foreground="#914c54"/>
  <style name="DiffFile" foreground="#7aa2f7"/>
  <style name="DiffLocation" foreground="#ff9e64"/>
  <style name="DiffFileLine" foreground="#1a1b26" background="#e0af68"/>
  <style name="DiffContextLine" foreground="#1a1b26" background="#2a2e40"/>
  <style name="DiffSourceLine" background="#823c41"/>
  <style name="DiffSourceChar" foreground="#1a1b26" background="#ff5370"/>
  <style name="DiffDestLine" background="#164846"/>
  <style name="DiffDestChar" foreground="#1a1b26" background="#449dab"/>
  <style name="MergeConflictCurrent" background="#2a2e40"/>
  <style name="MergeConflictIncoming" background="#394b70"/>
  <style name="MergeConflictBase" background="#1e202e"/>
  <style name="LogChangeLine" foreground="#6183bb"/>
  <style name="LogAuthorName" foreground="#73daca"/>
  <style name="LogCommitDate" foreground="#449dab"/>
  <style name="LogCommitHash" foreground="#ff9e64"/>
  <style name="LogCommitSubject" foreground="#a9b1d6"/>
  <style name="LogDecoration" foreground="#bb9af7"/>
  <style name="LogCommitFooter" foreground="#ff9e64"/>
  <style name="Info" underlineColor="#0da0ba" underlineStyle="DashUnderline"/>
  <style name="InfoContext" underlineColor="#0da0ba" underlineStyle="DotLine"/>
  <style name="Warning" underlineColor="#e0af68" underlineStyle="SingleUnderline"/>
  <style name="WarningContext" underlineColor="#e0af68" underlineStyle="DotLine"/>
  <style name="Error" underlineColor="#db4b4b" underlineStyle="SingleUnderline"/>
  <style name="ErrorContext" underlineColor="#db4b4b" underlineStyle="DotLine"/>
</style-scheme>
