;Qt Creator interface theme: Tokyo Night Storm (Qt Creator)
;
; Derived from Qt Creator's "Dark (2024)" theme.
; The Include chain below is intentionally kept unchanged
; so that every colour token resolves; this file only
; overrides the visible accent / surface colours and the
; terminal ANSI palette with Tokyo Night values.
;
;   dark.figmatokens -> primitive-colors.inc  (upstream)
;   2024.tokenmapping                        (upstream)
;   qmldesigner-dark.inc                     (upstream)
;
; Colour format: AARRGGBB

[General]
Includes=dark.figmatokens, 2024.tokenmapping, qmldesigner-dark.inc
ThemeName=Tokyo Night Storm (Qt Creator)
PreferredStyles=
DefaultTextEditorColorScheme=tokyo-night-storm.xml
DefaultToolbarStyle=Relaxed

[Palette]
PaletteWindow=ff1f2335
PaletteWindowText=ffa9b1d6
